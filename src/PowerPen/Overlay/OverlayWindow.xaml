<Window x:Class="PowerPen.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerPen Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <!-- InkCanvas defaults to a white background; it must be transparent so the desktop shows through.
             The code-behind switches it to a near-transparent brush in Draw mode so it can catch the mouse.
             Text items are added as its children. -->
        <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" />

        <!-- Live preview of the shape being dragged. Same origin as the InkCanvas, never takes input. -->
        <InkPresenter x:Name="Preview" IsHitTestVisible="False" />
    </Grid>
</Window>
