<Window x:Class="PowerPen.Capture.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerPen Screenshot"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross">

    <!-- Layout rounding + nearest-neighbor keep the frozen image pixel-sharp (it's shown at exactly 1:1). -->
    <Grid x:Name="Root" UseLayoutRounding="True">
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Darkens everything except the selection, which is cut out of this shape. -->
        <Path x:Name="Dim" Fill="#80000000" IsHitTestVisible="False" />

        <Rectangle x:Name="SelectionBorder" Stroke="White" StrokeThickness="1" StrokeDashArray="4 3"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="SizeLabel" Background="#E0202020" CornerRadius="3" Padding="6,2"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
        </Border>

        <Border x:Name="Hint" Background="#E0202020" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="6" Padding="14,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="14" FontFamily="Segoe UI"
                       Text="Drag to capture an area  ·  Click to capture this screen  ·  Esc to cancel" />
        </Border>
    </Grid>
</Window>
