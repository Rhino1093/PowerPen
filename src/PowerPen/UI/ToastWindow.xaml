<Window x:Class="PowerPen.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerPen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="#202020"
        Cursor="Hand">

    <Border BorderBrush="#3C3C3C" BorderThickness="1" Padding="14,10">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                       Foreground="#F2F2F2" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel MaxWidth="360">
                <TextBlock x:Name="TitleText" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Foreground="#B0B0B0" FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
