<Window x:Class="PowerPen.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PowerPen.UI"
        Title="PowerPen Settings"
        Icon="/Assets/PowerPen.ico"
        Width="580" Height="760" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F5F5F" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ui:HotkeyBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Root carries the background so the window can also be rendered to an image (see SaveSnapshot). -->
    <DockPanel x:Name="Root" Background="#F7F7F7">
        <!-- Buttons -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Problems (only when Save found some) -->
        <Border DockPanel.Dock="Bottom" Background="#FDECEE" BorderBrush="#E8A1A9" BorderThickness="0,1,0,0" Padding="16,8"
                Visibility="{Binding ProblemsVisibility}">
            <TextBlock Text="{Binding Problems}" Foreground="#9B1C2C" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,2,20,20">

                <!-- Colors -->
                <TextBlock Style="{StaticResource Section}" Text="Colors" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Up to 8 colors. Click a circle to pick a color, or type a code like #E53935. The name shows in the toolbar tooltip." />
                <ItemsControl ItemsSource="{Binding Colors}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Width="30" Height="28" Padding="0" Command="{Binding PickCommand}" ToolTip="Pick a color">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding PreviewBrush}"
                                            BorderBrush="#777777" BorderThickness="1" />
                                </Button>
                                <TextBox Width="160" Margin="8,0,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Name shown in the toolbar tooltip" />
                                <TextBox Width="90" Margin="8,0,0,0" FontFamily="Consolas"
                                         Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Color code, e.g. #E53935" />
                                <TextBlock Text="{Binding KeyHint}" Foreground="#5F5F5F" VerticalAlignment="Center" Width="48" Margin="12,0,0,0" />
                                <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="8,2" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add color" Command="{Binding AddColorCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" />

                <!-- Sizes -->
                <TextBlock Style="{StaticResource Section}" Text="Line and text sizes" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Line widths for the size button ([ and ] while drawing). Text size follows the same choice. The highlighter is this many times wider than the pen." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="Small" />
                    <TextBox Width="56" Text="{Binding SmallSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="Medium" Margin="20,0,12,0" />
                    <TextBox Width="56" Text="{Binding MediumSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="Large" Margin="20,0,12,0" />
                    <TextBox Width="56" Text="{Binding LargeSize, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="Highlighter width ×" />
                    <TextBox Width="56" Text="{Binding HighlighterMultiplier, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Hotkeys -->
                <TextBlock Style="{StaticResource Section}" Text="Hotkeys (work from any app)" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Click a box, then press the keys. Backspace turns a hotkey off. Keys used while drawing (P, H, E, L, A, R, O, T, 1–8, [ ], Ctrl+Z) are fixed." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Switch Draw / Pointer mode" />
                    <ui:HotkeyBox Grid.Row="0" Grid.Column="1" Combination="{Binding ToggleDraw}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Hide / show ink" />
                    <ui:HotkeyBox Grid.Row="1" Grid.Column="1" Combination="{Binding ToggleInkVisible}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Clear all ink" />
                    <ui:HotkeyBox Grid.Row="2" Grid.Column="1" Combination="{Binding ClearAll}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Quit PowerPen" />
                    <ui:HotkeyBox Grid.Row="3" Grid.Column="1" Combination="{Binding Quit}" />

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Pick a color (+ 1–8)" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                ToolTip="Hold these and press 1–8 to start drawing in that color. Untick all to turn color hotkeys off.">
                        <CheckBox Content="Ctrl" IsChecked="{Binding ColorCtrl}" Margin="0,4,14,4" />
                        <CheckBox Content="Alt" IsChecked="{Binding ColorAlt}" Margin="0,4,14,4" />
                        <CheckBox Content="Shift" IsChecked="{Binding ColorShift}" Margin="0,4,14,4" />
                        <CheckBox Content="Win" IsChecked="{Binding ColorWin}" />
                    </StackPanel>
                </Grid>

                <!-- Screenshots -->
                <TextBlock Style="{StaticResource Section}" Text="Screenshots" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="Save to" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ScreenshotFolder, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding FolderHint}" Margin="0,4,0,4" />
                <CheckBox Content="Also copy each screenshot to the clipboard" IsChecked="{Binding CopyToClipboard}" />
                <CheckBox Content="Hide the toolbar from screenshots and screen sharing (Teams, Zoom)" IsChecked="{Binding HideToolbarFromCapture}" />

                <!-- General -->
                <TextBlock Style="{StaticResource Section}" Text="General" />
                <CheckBox Content="Start PowerPen when Windows starts" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding FilesHint}" Margin="0,10,0,0" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
