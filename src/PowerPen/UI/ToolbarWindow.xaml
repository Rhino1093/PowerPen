<Window x:Class="PowerPen.UI.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PowerPen.UI"
        xmlns:core="clr-namespace:PowerPen.Core"
        Title="PowerPen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="#202020">

    <Window.Resources>
        <!-- Segoe Fluent Icons ships with Windows 11; MDL2 Assets is the Windows 10 fallback with the same code points. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Square icon button. Triggers later in the list win, so Active beats hover and Pressed beats both. -->
        <Style x:Key="ToolButtonStyle" TargetType="ui:ToolButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <!-- Not focusable: the toolbar must never take keyboard focus from the overlay or your app. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ToolButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363636" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2F5F8F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#464646" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline icon for the shape tools, drawn in the button's text color. -->
        <Style x:Key="ShapeIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:ToolButton}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <!-- Round color swatch; the selected one gets a white ring. Its fill comes from Background. -->
        <Style x:Key="SwatchButtonStyle" TargetType="ui:ToolButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ToolButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="#808080" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" Stroke="#5A5A5A" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#F2F2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="#3C3C3C" />
            <Setter Property="Margin" Value="4,4" />
        </Style>
    </Window.Resources>

    <!-- Root carries the background and border so the toolbar can also be rendered to an image (see SaveSnapshot). -->
    <Border x:Name="Root" Background="#202020" BorderBrush="#3C3C3C" BorderThickness="1">
        <Grid>
        <!-- Collapsed: a drag handle and one button that brings the toolbar back (lit while drawing). -->
        <StackPanel Width="40" Margin="4" Visibility="{Binding CollapsedVisibility}">
            <Border Height="14" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move"
                    MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#8A8A8A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ui:ToolButton x:Name="ExpandButton" Style="{StaticResource ToolButtonStyle}" Content="&#xEE56;"
                           Command="{Binding ExpandCommand}" IsActive="{Binding IsDrawing}" ToolTip="{Binding ExpandToolTip}" />
        </StackPanel>

        <StackPanel Width="84" Margin="4" Visibility="{Binding ExpandedVisibility}">
            <!-- Drag handle -->
            <Border Height="18" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move"
                    MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#8A8A8A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Mode and tools, two per row so every tool is one click away -->
            <UniformGrid Columns="2">
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Content="&#xE8B0;"
                               Command="{Binding PointerCommand}" IsActive="{Binding IsPointerActive}"
                               ToolTip="{Binding PointerToolTip}" />
                <ui:ToolButton x:Name="PenButton" Style="{StaticResource ToolButtonStyle}" Content="&#xEE56;"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Pen}"
                               IsActive="{Binding IsPenActive}" ToolTip="{Binding PenToolTip}" />
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Content="&#xE7E6;"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Highlighter}"
                               IsActive="{Binding IsHighlighterActive}" ToolTip="{Binding HighlighterToolTip}" />
                <ui:ToolButton x:Name="EraserButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE75C;"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Eraser}"
                               IsActive="{Binding IsEraserActive}" ToolTip="{Binding EraserToolTip}" />

                <ui:ToolButton x:Name="LineButton" Style="{StaticResource ToolButtonStyle}"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Line}"
                               IsActive="{Binding IsLineActive}" ToolTip="{Binding LineToolTip}">
                    <Path Style="{StaticResource ShapeIcon}" Data="M3,15 L15,3" />
                </ui:ToolButton>
                <ui:ToolButton x:Name="ArrowButton" Style="{StaticResource ToolButtonStyle}"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Arrow}"
                               IsActive="{Binding IsArrowActive}" ToolTip="{Binding ArrowToolTip}">
                    <Path Style="{StaticResource ShapeIcon}" Data="M3,15 L15,3 M8,3 L15,3 L15,10" />
                </ui:ToolButton>
                <ui:ToolButton x:Name="RectangleButton" Style="{StaticResource ToolButtonStyle}"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Rectangle}"
                               IsActive="{Binding IsRectangleActive}" ToolTip="{Binding RectangleToolTip}">
                    <Path Style="{StaticResource ShapeIcon}" Data="M2.5,4.5 H15.5 V13.5 H2.5 Z" />
                </ui:ToolButton>
                <ui:ToolButton x:Name="EllipseButton" Style="{StaticResource ToolButtonStyle}"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Ellipse}"
                               IsActive="{Binding IsEllipseActive}" ToolTip="{Binding EllipseToolTip}">
                    <Path Style="{StaticResource ShapeIcon}" Data="M1.5,9 A7.5,5.5 0 1 1 16.5,9 A7.5,5.5 0 1 1 1.5,9 Z" />
                </ui:ToolButton>

                <ui:ToolButton x:Name="TextButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE8D2;"
                               Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:ToolType.Text}"
                               IsActive="{Binding IsTextActive}" ToolTip="{Binding TextToolTip}" />
                <!-- Size: the dot shows the current size and color (applies to lines, shapes, and text) -->
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Command="{Binding CycleSizeCommand}" ToolTip="{Binding SizeToolTip}">
                    <Ellipse Width="{Binding SizeDotDiameter}" Height="{Binding SizeDotDiameter}"
                             Fill="{Binding CurrentBrush}" Stroke="#5A5A5A" StrokeThickness="1" />
                </ui:ToolButton>
            </UniformGrid>

            <Rectangle Style="{StaticResource Divider}" />

            <!-- Colors: 4 columns x 2 rows -->
            <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:ToolButton Style="{StaticResource SwatchButtonStyle}"
                                       Background="{Binding Brush}" IsActive="{Binding IsSelected}"
                                       Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Style="{StaticResource Divider}" />

            <!-- Actions -->
            <UniformGrid Columns="2">
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Content="&#xE7A7;"
                               Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" />
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Content="{Binding InkToggleGlyph}"
                               Command="{Binding ToggleInkCommand}" IsActive="{Binding IsInkHidden}"
                               ToolTip="{Binding InkToggleToolTip}" />
                <ui:ToolButton Style="{StaticResource ToolButtonStyle}" Content="&#xE74D;"
                               Command="{Binding ClearAllCommand}" ToolTip="{Binding ClearAllToolTip}" />
                <ui:ToolButton x:Name="ScreenshotButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE722;"
                               Command="{Binding ScreenshotCommand}" ToolTip="{Binding ScreenshotToolTip}" />
                <ui:ToolButton x:Name="SettingsButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE713;"
                               Command="{Binding OpenSettingsCommand}" ToolTip="{Binding SettingsToolTip}" />
                <ui:ToolButton x:Name="CollapseButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE70E;"
                               Command="{Binding CollapseCommand}" ToolTip="{Binding CollapseToolTip}" />
            </UniformGrid>
        </StackPanel>
        </Grid>
    </Border>
</Window>
