<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray icon and System.Drawing screen capture. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 tells WinForms apps to set DPI mode in code instead of the manifest. This is a WPF app,
         and WPF only reads DPI awareness from the manifest, so the warning doesn't apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, Color, Point, etc. Keep WinForms/Drawing out of the
         global usings so those names always mean the WPF version; files that need System.Drawing import it explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
